<!DOCTYPE html>
<html>
    <%- include("head.ejs") %>

    <body>
        <%- include("header.ejs") %>
        <div class="wrapper"></div>

        <% posts.forEach((post) => { %>
            <div class="ad">
                <h3><%= post.title %></h3>
                <p><%= post.desc %></p>
            </div>
        <% }) %>

        <%- include("modal.ejs") %>
        <button class="open">+</button>
        
        <%- include("footer.ejs") %>
    </body>
</html>
