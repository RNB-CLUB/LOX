<!DOCTYPE html>
<html>
<%- include("head.ejs") %>

    <body>
        <%- include("header.ejs") %>
            <main class="post">
                <h1>
                    <%= post.title %>
                </h1>
                <p>
                    <%= post.description %>
                </p>
                <div class="images">
                    <% if(post.image)post.image.forEach(i=>{ %>
                        <img src="<%=i%>" <%})%>
                </div>
            </main>
            <%- include("footer.ejs") %>
    </body>

</html>